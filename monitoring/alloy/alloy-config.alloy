logging {
	level  = "info"
	format = "logfmt"
}

// Discovery component for Docker containers
discovery.docker "containers" {
	host             = "unix:///var/run/docker.sock"
	refresh_interval = "5s"
}

// Relabeling to add container metadata
discovery.relabel "docker_logs" {
	targets = discovery.docker.containers.targets

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
		target_label  = "service"
	}

	rule {
		source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
		target_label  = "project"
	}

	rule {
		replacement  = "docker"
		target_label = "job"
	}
}

// logfmtフォーマットのログからlevelラベルを抽出するパイプライン
loki.process "extract_level" {
	// Lokiのreject_old_samples_max_age（デフォルト7日）より古いログは送信前に破棄する
	stage.drop {
		older_than          = "168h"
		drop_counter_reason = "too_old"
	}

	// scheduler/subscriberのみlogfmt形式でlevelを抽出（他サービスはJSONや独自フォーマットのためスキップ）
	stage.match {
		selector = `{service=~"scheduler|subscriber"}`

		stage.logfmt {
			mapping = {
				"level" = "",
			}
		}

		stage.labels {
			values = {
				"level" = "",
			}
		}
	}

	forward_to = [loki.write.loki.receiver]
}

// Log collection from Docker containers
loki.source.docker "docker_logs" {
	host             = "unix:///var/run/docker.sock"
	targets          = discovery.relabel.docker_logs.output
	refresh_interval = "5s"
	relabel_rules    = discovery.relabel.docker_logs.rules

	forward_to = [loki.process.extract_level.receiver]
}

// Static log collection from system files
loki.source.file "system_logs" {
	targets = [
		{
			__path__ = "/var/log/*log",
			job      = "varlogs",
		},
	]

	forward_to = [loki.write.loki.receiver]
}

// Write logs to Loki
loki.write "loki" {
	endpoint {
		url = "http://loki:3100/loki/api/v1/push"
	}
}
// Go のサービスが公開している pprof を定期的に取得し、Pyroscope に送る（Profiles Drilldown 用）
pyroscope.scrape "go_services" {
	targets = [
		{"__address__" = "backend:8082", "service_name" = "umi-mikan-backend"},
		{"__address__" = "subscriber:2005", "service_name" = "umi-mikan-subscriber"},
		{"__address__" = "scheduler:2006", "service_name" = "umi-mikan-scheduler"},
	]

	profiling_config {
		// runtime.SetMutexProfileFraction / SetBlockProfileRate を設定していないため、取得しても空になる
		profile.mutex {
			enabled = false
		}

		profile.block {
			enabled = false
		}
	}

	forward_to = [pyroscope.write.pyroscope.receiver]
}

pyroscope.write "pyroscope" {
	endpoint {
		url = "http://pyroscope:4040"
	}
}
